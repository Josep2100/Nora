{
  "name": "Nora - Tu Asistente Personal con IA",
  "short_name": "Nora",
  "description": "Nora es tu asistente personal inteligente con control por voz en tiempo real, visión artificial para escanear citas y documentos, lista de la compra organizada por pasillos y baúl de memoria.",
  "start_url": "/",
  "id": "com.nora.asistente.personal",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#100a1c",
  "theme_color": "#100a1c",
  "orientation": "any",
  "lang": "es",
  "dir": "ltr",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "192x192 256x256 384x384 512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "categories": [
    "productivity",
    "lifestyle",
    "utilities"
  ],
  "shortcuts": [
    {
      "name": "Hablar con Nora",
      "short_name": "Voz",
      "url": "/?action=voice",
      "description": "Dictar un recordatorio o hablar con Nora",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Podcast Mañanero",
      "short_name": "Podcast",
      "url": "/?action=podcast",
      "description": "Escuchar el resumen del día con Nora",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "screenshots": [
