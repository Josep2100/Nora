{
  "name": "nora-assistant",
  "version": "1.0.0",
  "description": "Nora | Tu Asistente Personal con IA, memoria de objetos, visión y voz",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "bot": "node security-bot.js",
    "test": "node --test test/core.test.js",
